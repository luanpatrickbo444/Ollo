# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Only server-side; never expose with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Jurema inference endpoint (see README: Jurema is not currently serverless on HF Inference Providers)
JUREMA_API_BASE_URL=https://YOUR-HUGGINGFACE-ENDPOINT/v1
JUREMA_API_KEY=YOUR_ENDPOINT_TOKEN
JUREMA_MODEL=Jurema-br/Jurema-7B

# Must match deployed site origin; no trailing slash
APP_URL=http://localhost:3000
